[Unit]
Description=Pick regional Gentoo mirrors by exit IP or system language (gig-os)
# 判据优先取出口 IP 的国家码，所以要等网络就绪；无法取得时脚本退回系统语言，网络不可用也不会失败。
# After gigos-live-lang 是为了让 live 先按 `gigos.lang=` 写好 locale.conf，本服务才有语言可读。
# 装好的系统没有 gigos-live-lang，locale.conf 由 Calamares 写，After 对不存在的单元无副作用。
Wants=network-online.target
After=local-fs.target network-online.target gigos-live-lang.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gigos-mirror.sh

[Install]
WantedBy=multi-user.target
