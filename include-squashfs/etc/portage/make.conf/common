COMMON_FLAGS="-O2 -pipe -march=x86-64-v3"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
# MAKEOPTS 在构建期由 refreshconfig() 按构建机重写，开机后由 gigos-cpuflags 按真机内存与核数覆盖，
# 此处仅为手动构建时的兜底值。
MAKEOPTS="-j32"

# Python 跟随 profile 默认（2026 树为 python3_14），不再 pin python3_13:全机单一变体，
# 与树默认一致且镜像精简。
